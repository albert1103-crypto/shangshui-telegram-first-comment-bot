{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shangshui-telegram-first-comment",
  "main": "src/index.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite" },
  "durable_objects": {
    "bindings": [
      { "name": "AUTOMATION_STATE", "class_name": "AutomationState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BotState"] },
    { "tag": "v2", "new_sqlite_classes": ["AutomationState"] }
  ]
}
